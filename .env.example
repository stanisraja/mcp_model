# Copy to .env and fill in. Never commit the real .env file (already gitignored).
# Every credential here should belong to a personal, non-work account/database,
# and should be a read-only role/user wherever the engine supports it.

# --- PostgreSQL ---
# POSTGRES_AUTH_MODE selects which of the two blocks below is used:
#   "password" (default) -- a plain connection string
#   "iam"                -- RDS IAM database authentication: a short-lived
#                            token is generated per connection instead of a
#                            stored password. Preferred for RDS. Requires
#                            the connecting Postgres user to have the
#                            rds_iam role granted, and IAM auth enabled on
#                            the RDS instance. Needs AWS credentials
#                            available (env vars / profile / instance role)
#                            with rds-db:connect + rds:GenerateDBAuthToken.
POSTGRES_AUTH_MODE=password

# Used when POSTGRES_AUTH_MODE=password (e.g. local Docker or Supabase free tier)
POSTGRES_DSN=postgresql://readonly_user:password@localhost:5432/portfolio

# Used when POSTGRES_AUTH_MODE=iam (e.g. RDS)
POSTGRES_HOST=database-1-instance-1.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DBNAME=postgres
POSTGRES_USER=readonly_user
POSTGRES_SSLMODE=require

POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_MAX_ROWS=500

# --- DynamoDB ---
# Table names are NOT configured here -- accessible tables come from a
# fixed registry in engines/dynamodb.py (_TABLE_TARGETS), the same
# allowlist pattern Postgres uses. AWS credentials should be scoped to
# exactly dynamodb:GetItem, dynamodb:Scan, and dynamodb:DescribeTable on
# those specific table ARNs -- that IAM policy is the real read-only
# guardrail, not the absence of a delete method in this code (see the
# "documented boundary" note in ARCHITECTURE.md).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave unset against a real AWS account -- boto3 then talks to the real
# regional DynamoDB endpoint for AWS_REGION. Only set this to
# http://localhost:8000 when running DynamoDB Local in Docker for dev.
DYNAMODB_ENDPOINT_URL=
DYNAMODB_MAX_ITEMS=500

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://readonly_user:password@cluster0.mongodb.net
MONGODB_DATABASE=portfolio
MONGODB_MAX_DOCUMENTS=500
